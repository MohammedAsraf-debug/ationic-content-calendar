# Copy this file to `.env` and fill in your Firebase project values.
# Get them from: Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
# NOTE: These values are public client config (safe to expose), but they are kept in env
# vars so nothing sensitive lives in source control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Comma separated list of the only accounts allowed to use the app.
# Leave empty in production: the defaults in src/lib/authorizedEmails.ts are used.
VITE_AUTHORIZED_EMAILS=