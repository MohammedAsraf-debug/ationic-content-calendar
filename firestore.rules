rules_version = '2';

// Ationic Content Hub — only the two approved team accounts may read or write data.
service cloud.firestore {
  match /databases/{database}/documents {

    // The only two accounts allowed to use the hub. Enforced here so a bypassed
    // client (direct REST/SDK calls) is rejected by the server, not just the UI.
    function isAllowedUser() {
      return request.auth != null
             && request.auth.token.email in [
               "sudalaikannan.work@gmail.com",
               "ationic.it@gmail.com"
             ];
    }

    match /content/{contentId} {
      allow read: if isAllowedUser();

      allow create: if isAllowedUser()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.publishDate is string;

      // creator is immutable and every change is attributed to the editor.
      allow update: if isAllowedUser()
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAllowedUser();
    }

    // Lightweight per-user profile, written by the user themselves on sign-in.
    match /users/{userId} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
    }

    // Nothing else is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
